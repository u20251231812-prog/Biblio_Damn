-- 1. Creación de Tablas Normalizadas
CREATE TABLE IF NOT EXISTS categorias (
    id_categoria SERIAL PRIMARY KEY,
    nombre VARCHAR(100) NOT NULL UNIQUE
);

CREATE TABLE IF NOT EXISTS autores (
    id_autor SERIAL PRIMARY KEY,
    nombre VARCHAR(150) NOT NULL,
    nacionalidad VARCHAR(100) NOT NULL
);

CREATE TABLE IF NOT EXISTS estudiantes (
    id_estudiante SERIAL PRIMARY KEY,
    codigo_estudiantil VARCHAR(30) NOT NULL UNIQUE,
    nombre VARCHAR(150) NOT NULL,
    correo VARCHAR(150) NOT NULL UNIQUE
);

CREATE TABLE IF NOT EXISTS libros (
    id_libro SERIAL PRIMARY KEY,
    titulo VARCHAR(200) NOT NULL,
    portada_url TEXT NOT NULL,
    stock_disponible INT NOT NULL DEFAULT 1 CHECK (stock_disponible >= 0),
    id_categoria INT NOT NULL REFERENCES categorias(id_categoria) ON DELETE RESTRICT,
    id_autor INT NOT NULL REFERENCES autores(id_autor) ON DELETE RESTRICT
);

CREATE TABLE IF NOT EXISTS reservas (
    id_reserva SERIAL PRIMARY KEY,
    id_estudiante INT NOT NULL REFERENCES estudiantes(id_estudiante) ON DELETE RESTRICT,
    id_libro INT NOT NULL REFERENCES libros(id_libro) ON DELETE RESTRICT,
    codigo_qr VARCHAR(50) NOT NULL UNIQUE,
    estado VARCHAR(20) NOT NULL DEFAULT 'Pendiente' CHECK (estado IN ('Pendiente', 'Reclamado', 'Devuelto')),
    fecha_reserva TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP
);

